{
  "name": "island-tree",
  "version": "1.0.0",
  "description": "Shows the vault's folders and files as an animated, canvas-style dashboard.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "svelte-check --tsconfig tsconfig.json && node esbuild.config.mjs production",
    "check": "svelte-check --tsconfig tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "check:release": "node scripts/check-guidelines.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@eslint/json": "0.14.0",
    "@types/node": "^22.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.0",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "svelte": "^5.57.0",
    "svelte-check": "^4.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@xyflow/svelte": "^1.7.0"
  }
}
